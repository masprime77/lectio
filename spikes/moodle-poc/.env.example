# Single-account (default):
MOODLE_BASE_URL=https://moodle.tu-darmstadt.de
MOODLE_TOKEN=paste-your-mobile-app-web-service-token-here

# Multi-account (optional) -- uncomment and fill in to test against more than
# one Moodle account/instance from this one file. Account ids in
# MOODLE_ACCOUNTS map to MOODLE_<ID>_BASE_URL / MOODLE_<ID>_TOKEN (id
# uppercased, non-alphanumerics become underscores). Select one with
# --account=<id> on the command line; if MOODLE_ACCOUNTS lists exactly one
# account, --account can be omitted. Output filenames gain the account id so
# two accounts' dumps never overwrite each other.
# MOODLE_ACCOUNTS=tu_informatik,tu_main
# MOODLE_TU_INFORMATIK_BASE_URL=https://moodle.informatik.tu-darmstadt.de
# MOODLE_TU_INFORMATIK_TOKEN=your-first-token-here
# MOODLE_TU_MAIN_BASE_URL=https://moodle.tu-darmstadt.de
# MOODLE_TU_MAIN_TOKEN=your-second-token-here
